# =============================================================================
#  CodeMaster AI - backend environment TEMPLATE (safe to commit - no real values)
#  Copy to .env / .env.development / .env.production and fill in.
#  Load order (later files win): .env -> .env.local -> .env.<mode> -> .env.<mode>.local
#  <mode> = development (npm run dev) | production (npm start)
#  Real OS environment variables always win over these files.
# =============================================================================

# ---------------------------------------------------------------- shared (.env)
ADMIN_EMAIL=you@example.com
APP_TIMEZONE=Asia/Kolkata
# Empty = built-in embedded MongoDB. Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Optional: force DNS servers for mongodb+srv lookups, e.g. 1.1.1.1,8.8.8.8
DNS_SERVERS=

# Google Gemini (free) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free) - https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras (free) - https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter (free ":free" models) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Mistral (free Experiment plan) - https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# SambaNova Cloud (free) - https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
# NVIDIA NIM (free credits) - https://build.nvidia.com
NVIDIA_API_KEY=
# Cohere (free trial) - https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Hugging Face (free credits) - https://huggingface.co/settings/tokens
HF_TOKEN=
# Z.ai - Zhipu GLM (free *-flash models) - https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# SiliconFlow (free small models) - https://cloud.siliconflow.com/account/ak
SILICONFLOW_API_KEY=
# Together AI - https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# Cloudflare Workers AI (free daily quota) - https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# DeepSeek (paid, cheap) - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenAI (paid) - https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic Claude (paid) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Ollama on this PC (free, no key) - e.g. http://localhost:11434
OLLAMA_BASE_URL=
# Any other OpenAI-compatible API
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Optional model overrides - comma separate for in-provider fallback
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite

WANDBOX_ENABLED=true
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_AUTH_TOKEN=
PISTON_URL=

# ---------------------------------------------------------------- per mode (.env.development / .env.production)
PORT=5050
# development: 127.0.0.1   production: 0.0.0.0
HOST=127.0.0.1
# development: http://localhost:5173   production: your public URL
CLIENT_ORIGIN=http://localhost:5173
# production behind a proxy: 1
TRUST_PROXY=loopback
REQUEST_LOGS=true
# development: codemaster_dev   production: codemaster
MONGODB_DB=codemaster_dev
# Plain password (fine for development) ...
ADMIN_PASSWORD=change-me
# ... or a scrypt hash (recommended for production): npm --prefix backend run hash-password -- "password"
ADMIN_PASSWORD_HASH=
# Long random string, different per mode: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# development: 7d   production: 12h
JWT_EXPIRES_IN=7d
EMBEDDED_MONGO_PATH=./data/mongo
EMBEDDED_MONGO_PORT=27027
