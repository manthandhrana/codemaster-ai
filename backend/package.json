{
  "name": "codemaster-backend",
  "version": "1.0.0",
  "description": "CodeMaster AI - Express backend (multi-AI question generator, judge, automation)",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=prompts --watch-path=.env --watch-path=.env.development src/index.js",
    "start": "node src/index.js --production",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "hash-password": "node scripts/hash-password.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "ajv": "^8.20.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonrepair": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.10.3",
    "node-cron": "^3.0.3"
  }
}
