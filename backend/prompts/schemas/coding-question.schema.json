{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "coding-question",
  "title": "Coding question - stored form (schemaVersion 1)",
  "description": "Every AI answer for a coding problem is normalized to this shape and validated BEFORE it is saved (title/topic/tags become top-level fields, the rest is questions.data).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "topic",
    "tags",
    "pattern",
    "description",
    "inputFormat",
    "outputFormat",
    "constraints",
    "examples",
    "testCases",
    "hints",
    "approach",
    "complexity",
    "starterCode",
    "starterCodes",
    "solutionCode",
    "followUps"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "topic": { "type": "string", "maxLength": 60 },
    "tags": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 30 } },
    "pattern": { "type": "string", "maxLength": 80 },
    "description": { "type": "string", "minLength": 30 },
    "inputFormat": { "type": "string" },
    "outputFormat": { "type": "string" },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "examples": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/definitions/example" } },
    "testCases": { "type": "array", "maxItems": 15, "items": { "$ref": "#/definitions/test" } },
    "hints": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
    "approach": { "type": "string" },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "space"],
      "properties": { "time": { "type": "string" }, "space": { "type": "string" } }
    },
    "starterCode": { "type": "string", "minLength": 1 },
    "starterCodes": { "type": "object", "additionalProperties": { "type": "string" } },
    "solutionCode": { "type": "string", "minLength": 10 },
    "referenceJs": { "type": "string", "minLength": 10 },
    "followUps": { "type": "array", "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
    "verification": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["verified", "failed", "unverifiable", "skipped"] },
        "by": { "type": "string" },
        "reason": { "type": "string" },
        "fixed": { "type": "integer", "minimum": 0 },
        "dropped": { "type": "integer", "minimum": 0 },
        "matched": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "definitions": {
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "explanation"],
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string" }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 }
      }
    }
  }
}
