{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mcq-question",
  "title": "MCQ - stored form (schemaVersion 1)",
  "description": "One multiple-choice question after normalization (options shuffled, correctIndex re-mapped). Validated BEFORE it is saved; title/topic/tags become top-level fields, the rest is questions.data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "topic", "tags", "question", "options", "correctIndex", "explanation", "hints"],
  "properties": {
    "title": { "type": "string", "minLength": 3, "maxLength": 90 },
    "topic": { "type": "string", "maxLength": 60 },
    "tags": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 30 } },
    "question": { "type": "string", "minLength": 10 },
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "correctIndex": { "type": "integer", "minimum": 0, "maximum": 5 },
    "explanation": { "type": "string", "minLength": 1 },
    "hints": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 } }
  }
}
