# =============================================================================
#  CodeMaster AI - frontend (Vite) environment template
#  Vite load order: .env -> .env.local -> .env.<mode> -> .env.<mode>.local
#  Only variables prefixed with VITE_ are exposed to browser code.
#  NEVER put secrets (API keys, admin password) in frontend env files -
#  they belong to backend/.env
# =============================================================================

# App name shown in the UI / browser tab
VITE_APP_NAME=CodeMaster AI

# Base URL of the backend API.
#   /api                              -> same origin (dev proxy or Express serving the build)
#   https://api.example.com/api       -> frontend hosted separately from the backend
VITE_API_URL=/api

# (dev only, not exposed to the browser) backend address for the Vite proxy
DEV_API_PROXY=http://127.0.0.1:5050
